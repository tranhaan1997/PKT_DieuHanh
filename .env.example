# PostgreSQL (dùng bởi docker-compose.dev.yml)
POSTGRES_DB=dh_telecom
POSTGRES_USER=dh_user
POSTGRES_PASSWORD=DH_Telecom@2026#Pg

# Backend — local (npm run start:dev): host=localhost, port=5442
# Nếu chạy backend trong Docker Compose: host=postgres, port=5432
# Password encode: @ → %40 | # → %23
DATABASE_URL=postgresql://dh_user:DH_Telecom%402026%23Pg@localhost:5442/dh_telecom
JWT_SECRET=dev_jwt_secret_key_minimum_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_key_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=7d
PORT=3011
NODE_ENV=development
CORS_ORIGIN=http://localhost:5183
FRONTEND_URL=http://localhost:5183

# Frontend — để trống để Vite proxy /api → localhost:3011
VITE_API_URL=
