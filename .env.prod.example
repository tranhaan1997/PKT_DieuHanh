# Copy file này thành .env trên server, điền giá trị thật

# GHCR
GHCR_OWNER=tayeumi
GHCR_TOKEN=                        # PAT với scope read:packages (chỉ cần nếu package là private)
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_DB=dh_telecom
POSTGRES_USER=dh_user
POSTGRES_PASSWORD=                  # đặt mật khẩu mạnh (chỉ dùng cho postgres container)

# DATABASE_URL — bắt buộc phải set, encode ký tự đặc biệt trong password:
#   @ → %40  |  # → %23  |  : → %3A  |  / → %2F
# Ví dụ password "DH_Telecom2026#Pg" → "DH_Telecom2026%23Pg"
DATABASE_URL=postgresql://dh_user:YOUR_PASSWORD_ENCODED@postgres:5432/dh_telecom

# JWT
JWT_SECRET=                         # chuỗi ngẫu nhiên >= 32 ký tự
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=                 # chuỗi ngẫu nhiên khác >= 32 ký tự
JWT_REFRESH_EXPIRES_IN=7d

# App
CORS_ORIGIN=*
FRONTEND_PORT=80

# SSO / AMS (bỏ trống nếu chưa dùng)
# AMS chỉ cho đăng ký 1 Redirect URI cho mỗi client → SSO_REDIRECT_URI phải khớp
# từng ký tự (http/https, cổng, không có "/" cuối) với Redirect URI của client trên AMS
SSO_CLIENT_ID=AMS_PKT
SSO_CLIENT_SECRET=                  # do AMS cấp khi tạo client
SSO_AUTHORIZE_URL=https://ams.vienthongact.vn/Api/Sso/Authorize
SSO_TOKEN_URL=https://ams.vienthongact.vn/Api/Sso/Token
SSO_USERINFO_URL=https://ams.vienthongact.vn/Api/Sso/UserInfo
SSO_REFRESH_URL=https://ams.vienthongact.vn/Api/Auth/Refresh_Token
SSO_REDIRECT_URI=https://<domain>/api/auth/sso/callback
AMS_API_URL=https://ams.vienthongact.vn/Api
AMS_SYNC_TOKEN=
FRONTEND_URL=https://<domain>
ALLOWED_ORIGINS=https://<domain>
